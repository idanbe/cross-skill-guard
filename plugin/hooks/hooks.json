{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v crosskill-guard >/dev/null && crosskill-guard || echo '{\"systemMessage\": \"crosskill guard is not active: install its CLI with pipx install git+https://github.com/idanbe/cross-skill-guard\"}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "crosskill-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "crosskill-guard"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "crosskill-guard"
          }
        ]
      }
    ]
  }
}
